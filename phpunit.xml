<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         testdox="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Grpc/GrpcClientTest.php</exclude>
            <exclude>tests/Unit/Grpc/GrpcClientTimevalDeadlineTest.php</exclude>
            <exclude>tests/Unit/Grpc/RawKvBatchTimevalDeadlineTest.php</exclude>
            <exclude>tests/Unit/Batch/GrpcFutureTest.php</exclude>
            <exclude>tests/Unit/RawKv/RawKvBatchTest.php</exclude>
            <exclude>tests/Unit/RawKv/RawKvBatchConcurrencyCapTest.php</exclude>
            <exclude>tests/Unit/RawKv/RawKvClientTest.php</exclude>
            <exclude>tests/Unit/Batch/BatchAsyncExecutorTest.php</exclude>
            <exclude>tests/Unit/Batch/CheckedGrpcFutureTest.php</exclude>
            <exclude>tests/Unit/RawKv/SstIngestorTest.php</exclude>
            <exclude>tests/Unit/RawKv/RawKvBatchBatchCommandsGrpcTest.php</exclude>
            <exclude>tests/Unit/RawKv/RawKvBatchSlowLogWiringTest.php</exclude>
        </testsuite>
        <testsuite name="Grpc">
            <!-- The gRPC-dependent classes live here (they mock \Grpc\Call and
                 need ext-grpc, which the unit-tests CI job does not install).
                 ParallelRangeOpsCapTest and
                 CheckedGrpcFutureRetryableDispatchTest are pure PHP: they run
                 in the Unit suite (no ext needed) and are deliberately NOT
                 listed here again — a file that is in two selected suites
                 makes PHPUnit emit "Cannot add file ... as it was already
                 added to test suite ...", which fails the run that selects
                 both suites (the CI coverage job). -->
            <file>tests/Unit/Grpc/GrpcClientTest.php</file>
            <file>tests/Unit/Grpc/GrpcClientTimevalDeadlineTest.php</file>
            <file>tests/Unit/Grpc/RawKvBatchTimevalDeadlineTest.php</file>
            <file>tests/Unit/Batch/GrpcFutureTest.php</file>
            <file>tests/Unit/RawKv/RawKvBatchTest.php</file>
            <file>tests/Unit/RawKv/RawKvBatchConcurrencyCapTest.php</file>
            <file>tests/Unit/RawKv/RawKvClientTest.php</file>
            <file>tests/Unit/Batch/BatchAsyncExecutorTest.php</file>
            <file>tests/Unit/Batch/CheckedGrpcFutureTest.php</file>
            <file>tests/Unit/RawKv/RawKvBatchBatchCommandsGrpcTest.php</file>
            <file>tests/Unit/RawKv/RawKvBatchSlowLogWiringTest.php</file>
            <file>tests/Unit/RawKv/SstIngestorTest.php</file>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="E2E-RawKV">
            <directory>tests/E2E</directory>
            <exclude>tests/E2E/TxnKvE2ETest.php</exclude>
            <exclude>tests/E2E/GcSafePointE2ETest.php</exclude>
            <exclude>tests/E2E/FastCommitModesE2ETest.php</exclude>
            <exclude>tests/E2E/PdFailoverE2ETest.php</exclude>
            <exclude>tests/E2E/ApiV2E2ETest.php</exclude>
        </testsuite>
        <testsuite name="E2E-TxnKV">
            <file>tests/E2E/TxnKvE2ETest.php</file>
            <file>tests/E2E/GcSafePointE2ETest.php</file>
            <file>tests/E2E/FastCommitModesE2ETest.php</file>
            <file>tests/E2E/PdFailoverE2ETest.php</file>
        </testsuite>
        <testsuite name="E2E-ApiV2">
            <file>tests/E2E/ApiV2E2ETest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <!-- The generated protobuf/gRPC classes are not hand-written code:
             nobody writes tests for them, so counting them would drag the
             reported percentage down by more than half and make the coverage
             floor measure the generated code instead of the client. -->
        <exclude>
            <directory>src/Proto</directory>
        </exclude>
    </source>
    <coverage>
        <report>
            <clover outputFile="coverage.xml"/>
            <html outputDirectory="coverage-html"/>
        </report>
    </coverage>
</phpunit>
