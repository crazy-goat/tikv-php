{
    "name": "crazy-goat/tikv-client",
    "description": "PHP client for TiKV RawKV API using gRPC extension",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-grpc": ">=1.57",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^4.33.6 || ^5.0.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "infection/infection": "^0.31",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2",
        "slevomat/coding-standard": "^8.15",
        "rector/rector": "^2.3",
        "phpstan/phpstan": "^2.1",
        "monolog/monolog": "^3.10"
    },
    "config": {
        "audit": {
            "block-insecure": true,
            "abandoned": "report"
        },
        "platform": {
            "php": "8.2.0"
        },
        "process-timeout": 3600,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": false
        }
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\TiKV\\Client\\": "src/Client/",
            "CrazyGoat\\Proto\\": "src/Proto/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\TiKV\\Tests\\": "tests/",
            "CrazyGoat\\TiKV\\Phpstan\\": "phpstan/"
        }
    },
    "scripts": {
        "lint": "bash bin/lint.sh",
        "lint:fix": "bash bin/lint.sh --fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist",
        "test": "phpunit --testsuite Unit,Grpc,Integration --fail-on-empty-test-suite --no-coverage",
        "test:unit": "phpunit --testsuite Unit --fail-on-empty-test-suite --no-coverage",
        "test:grpc": "phpunit --testsuite Grpc --fail-on-skipped --fail-on-empty-test-suite --no-coverage",
        "test:coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --testsuite Unit,Grpc --fail-on-skipped --fail-on-empty-test-suite --coverage-clover=coverage.xml && php bin/check-coverage.php coverage.xml",
        "test:e2e": "bash scripts/test-e2e.sh",
        "test:e2e:raw": "bash scripts/test-e2e-suite.sh E2E-RawKV",
        "test:e2e:txn": "bash scripts/test-e2e-suite.sh E2E-TxnKV",
        "test:e2e:apiv2": "bash scripts/test-e2e-suite.sh E2E-ApiV2",
        "mutation": "infection",
        "mutation:show": "infection --show-mutations",
        "pick-issue": "bash bin/pick-issue.sh",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    }
}
